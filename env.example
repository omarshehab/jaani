# ══════════════════════════════════════════════════════════════════════════
# JAANI — Environment Variables Template
# Copy to backend/.env (backend) and frontend/.env (frontend), then fill in
# your own values. Never commit a real .env file — see .gitignore.
# ══════════════════════════════════════════════════════════════════════════

# ─── Backend (backend/.env) ──────────────────────────────────────────────

# Server
PORT=5005
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ALLOW_ALL_CORS=false

# LLM providers — JAANI uses hosted LLMs only (OpenAI, xAI/Grok, Kimi/Moonshot).
# No local ML model, no MongoDB, no Twilio: these were deliberately removed —
# see "section files/s1_rtn.md" R14 and "section files/s3_RTIod.md" §6.
LLM_AUTO_ORDER=openai,grok,kimi
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
XAI_API_KEY=
GROK_MODEL=grok-4.20-non-reasoning
KIMI_API_KEY=
KIMI_MODEL=kimi-k3

# Per-task model overrides (cheap vs flagship tier — see s2_na.md §5.7)
TASK_CHEAP_OPENAI_MODEL=gpt-4o-mini
TASK_CHEAP_GROK_MODEL=grok-4.20-non-reasoning
TASK_CHEAP_KIMI_MODEL=kimi-k3
TASK_FLAGSHIP_OPENAI_MODEL=gpt-6-astra
TASK_FLAGSHIP_GROK_MODEL=grok-4.20-non-reasoning
TASK_FLAGSHIP_KIMI_MODEL=kimi-k3

# Sentence-salience ensemble (Section 1 "important sentence" highlighting —
# separate, usually cheaper models than the main pipeline above)
SALIENCE_OPENAI_MODEL=gpt-6-astra
SALIENCE_GROK_MODEL=grok-4.7
SALIENCE_KIMI_MODEL=kimi-k3
SALIENCE_PROVIDER_TIMEOUT_MS=30000
SALIENCE_TIMEOUT_MS_KIMI=45000
SALIENCE_MAX_BUDGET_RATIO=0.40

# OpenRouter (optional extra fallback provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-12b-it:free
OPENROUTER_MAX_TOKENS=500
OPENROUTER_FALLBACK_MAX_TOKENS=500
OPENROUTER_RETRY_MAX=2
OPENROUTER_RETRY_BASE_MS=500

# Live Page reader (Section 1) — serves the real rendered article on its own
# origin, port 5002. See s1_rtn.md §4.2 and §9.
READER_PORT=5002
READER_PUBLIC_ORIGIN=http://localhost:5002
READER_ALLOWLIST=www.prothomalo.com,www.thedailystar.net,bdnews24.com,www.dhakapost.com
# READER_APP_ORIGINS defaults to localhost:3000/5005 — only set to widen it
# READER_APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# READER_FRAME_ANCESTORS is OFF by default — only set this if you know you need
# a CSP frame-ancestors restriction; setting it can blank the Live Page if the
# app is ever itself embedded in another frame (see s1_rtn.md §8, item 10).
# READER_FRAME_ANCESTORS=

# SSRF / network safety
ALLOW_INSECURE_GOV_TLS=true
ALLOW_PRIVATE_NETWORK_URLS=false

# Evidence capture & retention (Section 2 forensic PDF — s2_na.md §5.6)
EVIDENCE_RETENTION_DAYS=90
EVIDENCE_LISTING_ENABLED=false

# Google Custom Search (used by Section 2/3's web-search fallbacks)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX_PRIMARY=
GOOGLE_SEARCH_CX_FALLBACK=

# Gmail OAuth (Section 4 — compose/send from the app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5005/api/gmail/oauth/callback

# Postmark (Section 4 transport — planned, not yet wired in; see project memory)
POSTMARK_API_TOKEN=

# Analyze/extraction budgets
ANALYZE_MAX_WORDS=2000
ANALYZE_QUICK_MAX_TOKENS=900
NEWS_EXTRACT_MAX_WORDS=2500
ENTITY_EXTRACT_TIMEOUT_MS=8000

# Fact-check feed polling (s2_na.md §5.5) — set to `off` for a second local instance
FACTCHECK_POLL=on

# ─── Scraper (scraper/.env, optional — only needed to re-run the officer-
#     directory fill pipeline described in scraper/README.md) ─────────────
JAANI_CONTACT_EMAIL=
KIMI_API_KEY=
XAI_API_KEY=

# ─── Frontend (frontend/.env) ────────────────────────────────────────────
REACT_APP_BACKEND_URL=http://localhost:5005
REACT_APP_READER_ORIGIN=http://localhost:5002
REACT_APP_GOOGLE_CLIENT_ID=
